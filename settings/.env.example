BLOG_ENV_ID=local
BLOG_SECRET_KEY=replace-with-a-new-random-secret
BLOG_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Production only: provision PostgreSQL and set these before selecting prod.
BLOG_DB_NAME=blog_api
BLOG_DB_USER=blog_api
BLOG_DB_PASSWORD=replace-with-your-database-password
BLOG_DB_HOST=127.0.0.1
BLOG_DB_PORT=5432
# HTTPS is required by default in production.
BLOG_CSRF_TRUSTED_ORIGINS=https://your-domain.example
